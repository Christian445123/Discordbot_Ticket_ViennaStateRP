# Discord Bot Token (https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here

# Discord Application Client ID
DISCORD_CLIENT_ID=your_client_id_here

# Discord Client Secret (for OAuth2 Web Login)
DISCORD_CLIENT_SECRET=your_client_secret_here

# Discord Guild ID (Server ID)
DISCORD_GUILD_ID=your_guild_id_here

# MySQL-Datenbank (Tabellen werden beim Start automatisch angelegt)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=db
DB_USER=db_user
DB_PASSWORD=change_this_to_your_real_db_password

# Web Interface Port
PORT=3000

# Web Interface Base URL (must match Discord OAuth2 Redirect URI)
BASE_URL=http://localhost:3000

# Session Secret (random string, min. 32 characters)
SESSION_SECRET=change_this_to_a_random_secret_string_min_32_chars

# Log-Level für Server-Logs: error | warn | info (Standard) | debug
LOG_LEVEL=info

# Discord-User-IDs (kommagetrennt), die /lizenz-admin nutzen dürfen — die
# serverübergreifende Lizenzverwaltung (erstellen/sperren/verlängern/liste)
SUPER_ADMIN_IDS=

# Secret für den signierten Offline-Lizenz-Cache (data/license-cache.json).
# Fällt auf SESSION_SECRET zurück, wenn nicht gesetzt.
LICENSE_CACHE_SECRET=

# Wie lange eine zuletzt gültige Lizenz bei DB-Ausfall offline als gültig
# gilt, bevor sie als ungültig behandelt wird (Stunden, Standard: 72)
LICENSE_OFFLINE_GRACE_HOURS=72

# Optional: registriert Slash-Commands nur für diese Guild statt global —
# für Entwicklung, da guild-scoped Commands sofort aktiv sind (global kann
# bis zu ~1h dauern). In Produktion leer lassen.
DEV_GUILD_ID=
